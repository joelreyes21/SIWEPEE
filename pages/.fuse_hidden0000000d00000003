<script>
  /* Safari/Chrome pueden restaurar el documento completo desde BFCache al
     volver o cerrar sesión. Si ocurre, pedimos una copia fresca con versión
     única para no revivir el login anterior que quedó congelado en memoria. */
  window.SIWEPE_ADMIN_BUILD='20260813.12';
  window.addEventListener('pageshow',function(ev){
    if(!ev.persisted) return;
    var u=new URL(location.href);
    u.searchParams.set('v',window.SIWEPE_ADMIN_BUILD+'-'+Date.now());
    location.replace(u.href);
  });
