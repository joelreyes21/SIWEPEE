          <div class="lf-campo"><label>Nueva contraseña</label><input type="password" id="reset-pass" placeholder="Mínimo 8 caracteres" autocomplete="new-password" maxlength="72"></div>
          <div class="lf-campo"><label>Confirmar contraseña</label><input type="password" id="reset-pass2" placeholder="Repetila" autocomplete="new-password" maxlength="72"></div>
          <div class="login-error" id="reset-error"></div>
          <button class="btn btn-primary admin-login-submit" id="btn-reset">Guardar contraseña</button>
        </div>

